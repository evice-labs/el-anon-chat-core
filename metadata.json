{
  "name": "el_anon_chat_core",
  "display_name": "EL Anon Chat Core",
  "version": "1.0.0",
  "type": "core",
  "interface": "universal",
  "category": "general",
  "description": "Anonymous chat core module wrapping e_identity_sdk and e_moderation_sdk via FFI",
  "main": "el_anon_chat_core_plugin",
  "codegen": {
    "impl_header": "src/el_anon_chat_core_impl.h",
    "impl_class": "ElAnonChatCoreImpl"
  },
  "dependencies": [],

  "nix": {
    "packages": {
      "build": ["nlohmann_json"],
      "runtime": ["nlohmann_json"]
    },
    "external_libraries": [
      {
        "name": "e_identity_sdk",
        "vendor_path": "lib"
      },
      {
        "name": "e_moderation_sdk",
        "vendor_path": "lib"
      }
    ],
    "cmake": {
      "find_packages": ["nlohmann_json"],
      "extra_sources": [],
      "extra_include_dirs": ["lib"],
      "extra_link_libraries": []
    }
  }
}
